# =============================================================================
# Variables d'environnement — Backend (référence #130)
# =============================================================================
# Copier vers `.env` (config non sensible) et compléter `.env.secrets` depuis
# `.env.secrets.example` pour les secrets.
#
# Légende : [OBLIGATOIRE] | [OPTIONNEL] | [SECRET → .env.secrets]
# =============================================================================

# --- Application ----------------------------------------------------------------

# [OPTIONNEL] Environnement d'exécution
# Format : development | production | test
# Exemple : development
NODE_ENV=development

# [OPTIONNEL] Port HTTP de l'API NestJS
# Format : entier 1–65535
# Exemple : 3000
PORT=3000

# --- Base de données ------------------------------------------------------------

# [SECRET → .env.secrets] URL Prisma (MariaDB/MySQL)
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Exemple : mysql://backend_user:backend_password@localhost:3306/backend_db
# DATABASE_URL=

# --- JWT & sessions -------------------------------------------------------------

# [SECRET → .env.secrets] Clé de signature des access tokens JWT
# Format : chaîne aléatoire ≥ 32 caractères (openssl rand -base64 48)
# Exemple : change-me-generate-a-strong-secret
# JWT_SECRET=

# [OPTIONNEL] Durée de vie de l'access token (secondes)
# Format : entier positif
# Exemple : 900
JWT_EXPIRES_IN=900

# [OPTIONNEL] Durée de vie du refresh token (secondes)
# Format : entier positif
# Exemple : 604800
REFRESH_TOKEN_EXPIRES_IN=604800

# [OPTIONNEL] Durée de vie du token de vérification email (secondes)
# Format : entier positif
# Exemple : 86400
EMAIL_VERIFY_EXPIRES_IN=86400

# --- CSRF -----------------------------------------------------------------------

# [SECRET → .env.secrets] Clé HMAC des tokens CSRF (sinon repli sur JWT_SECRET)
# Format : chaîne aléatoire ≥ 32 caractères
# Exemple : change-me-csrf-secret
# CSRF_SECRET=

# [OPTIONNEL] Durée de vie d'un token CSRF (millisecondes)
# Format : entier positif
# Exemple : 7200000
# CSRF_TTL_MS=7200000

# --- URLs -----------------------------------------------------------------------

# [OBLIGATOIRE] URL publique de l'API (liens dans les emails)
# Format : URL http(s) sans slash final
# Exemple : http://localhost:3000
APP_URL=http://localhost:3000

# [OPTIONNEL] URL du front-office (CORS, liens de repli)
# Format : URL http(s) sans slash final
# Exemple : http://localhost:3001
FRONTEND_URL=http://localhost:3001

# [OPTIONNEL] Origines autorisées pour le WebSocket ETL (séparées par des virgules)
# Format : liste d'URLs
# Exemple : http://localhost:3001,http://localhost:5173
# ETL_WS_ALLOWED_ORIGINS=

# --- Email (SMTP) ---------------------------------------------------------------

# [SECRET → .env.secrets] Hôte SMTP
# Format : hostname ou IP
# Exemple : smtp.example.com
# SMTP_HOST=

# [OPTIONNEL] Port SMTP
# Format : entier (587, 465, 25)
# Exemple : 587
SMTP_PORT=587

# [SECRET → .env.secrets] Identifiant SMTP
# Format : adresse email ou login
# Exemple : noreply@example.com
# SMTP_USER=

# [SECRET → .env.secrets] Mot de passe SMTP
# Format : chaîne
# Exemple : your-smtp-password
# SMTP_PASS=

# [OPTIONNEL] Adresse expéditeur par défaut
# Format : email valide
# Exemple : no-reply@example.com
SMTP_FROM=no-reply@example.com

# --- Kaggle (pipelines ETL) -----------------------------------------------------

# [SECRET → .env.secrets] Nom d'utilisateur Kaggle
# Format : slug Kaggle
# Exemple : mon_utilisateur
# KAGGLE_USER=

# [SECRET → .env.secrets] Clé API Kaggle
# Format : chaîne (token depuis https://www.kaggle.com/settings)
# Exemple : kg_xxxxxxxxxxxxxxxx
# KAGGLE_KEY=

# --- Micro-service workout (IA) -------------------------------------------------

# [OPTIONNEL] URL du service de recommandations sportives
# Format : URL http(s) sans slash final
# Exemple : http://localhost:8000
WORKOUT_SERVICE_URL=http://localhost:8000

# [SECRET → .env.secrets] Clé API du micro-service workout
# Format : chaîne
# Exemple : change-me-workout-api-key
# WORKOUT_SERVICE_API_KEY=
