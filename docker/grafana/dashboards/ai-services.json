{
  "uid": "ai-services",
  "title": "AI Services",
  "tags": ["healthai", "ai"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Appels IA / minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ai_api_calls_total[1m])) by (provider, type)",
          "legendFormat": "{{ provider }} — {{ type }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 2,
      "title": "Total appels IA par provider",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(ai_api_calls_total) by (provider)",
          "legendFormat": "{{ provider }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Durée des pipelines ETL (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(etl_pipeline_duration_seconds_bucket[5m])) by (le, pipeline))",
          "legendFormat": "p50 — {{ pipeline }}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(etl_pipeline_duration_seconds_bucket[5m])) by (le, pipeline))",
          "legendFormat": "p95 — {{ pipeline }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "time": { "from": "now-3h", "to": "now" }
}
