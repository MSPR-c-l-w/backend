{
  "uid": "ai-services",
  "title": "AI Services",
  "tags": ["healthai", "ai"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total appels IA (cumulé)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(ai_api_calls_total) or vector(0)", "legendFormat": "appels" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "color": {"mode":"thresholds"}, "thresholds": {"mode":"absolute","steps":[{"color":"blue","value":null}]} } }
    },
    {
      "id": 5,
      "title": "API IA disponible",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "up{job=\"api-ia-fastapi\"} or vector(0)", "legendFormat": "status" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] }, "mappings": [{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}] },
      "fieldConfig": { "defaults": { "color": {"mode":"thresholds"}, "thresholds": {"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]} } }
    },
    {
      "id": 6,
      "title": "Appels IA / min (dernière heure)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(rate(ai_api_calls_total[5m])) * 60 or vector(0)", "legendFormat": "appels/min" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Appels IA / minute (par provider & type)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 4 },
      "targets": [
        { "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(rate(ai_api_calls_total[1m])) by (provider, type) * 60", "legendFormat": "{{ provider }} — {{ type }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "title": "Répartition appels par provider",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 4 },
      "targets": [
        { "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(ai_api_calls_total) by (provider)", "legendFormat": "{{ provider }}", "instant": true }
      ]
    },
    {
      "id": 7,
      "title": "Logs IA (Loki)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "datasource": {"type":"loki","uid":"loki"}, "expr": "{container=~\"backend-nestjs\"} |~ \"workout|AiWorkout|generateProgram\"", "legendFormat": "" }
      ],
      "options": { "showLabels": false, "showTime": true, "sortOrder": "Descending" }
    }
  ],
  "time": { "from": "now-3h", "to": "now" }
}
