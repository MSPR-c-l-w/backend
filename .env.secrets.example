# =============================================================================
# Secrets — ne jamais committer ce fichier rempli (.env.secrets est gitignoré)
# =============================================================================
# Copier vers `.env.secrets` à la racine du projet :
#   cp .env.secrets.example .env.secrets
#
# Utilisé par : application locale (via load-env), Docker (env_file).
# Voir documentation/secrets-management.md pour la rotation JWT.
# =============================================================================

# Application / Prisma
# Local : host localhost — Docker Compose : host mariadb
DATABASE_URL=mysql://backend_user:backend_password@localhost:3306/backend_db
# DATABASE_URL=mysql://backend_user:backend_password@mariadb:3306/backend_db

# JWT & CSRF
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
CSRF_SECRET=

# SMTP
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Kaggle (ETL)
KAGGLE_USER=
KAGGLE_KEY=

# Micro-service workout
WORKOUT_SERVICE_API_KEY=change-me-workout-api-key

# Docker Compose — MariaDB (réseau healthai-internal)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=backend_password

# MongoDB (réseau interne — workout-api)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGODB_URI=mongodb://root:change-me-mongo-root@mongodb:27017/?authSource=admin

# MinIO (API :9000 interne, console :9001 publique)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# Grafana (réseau public :3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
